<script>
	document.addEventListener("DOMContentLoaded", () => {
		// Category filters
		const filterButtons = document.querySelectorAll("[data-filter]");
		const projectCells = document.querySelectorAll("[data-category]");

		filterButtons.forEach(btn => {
			btn.addEventListener("click", () => {
				// Update button styles
				filterButtons.forEach(b => {
					b.classList.remove("bg-white", "text-black", "border-white");
					b.classList.add("border-white/20", "text-white");
				});
				btn.classList.add("bg-white", "text-black", "border-white");
				btn.classList.remove("border-white/20", "text-white");

				const filterValue = btn.getAttribute("data-filter");

				projectCells.forEach(cell => {
					const categories = cell.getAttribute("data-category").split(" ");
					if (filterValue === "all" || categories.includes(filterValue)) {
						cell.style.display = "flex";
					} else {
						cell.style.display = "none";
					}
				});
			});
		});

		// Dynamic Scroll Backdrop Overlay
		const overlay = document.getElementById("scroll-overlay");
		const handleScroll = () => {
			const scrollTop = window.scrollY || document.documentElement.scrollTop;
			const fadeStart = 100; // start fading after 100px scroll
			const fadeEnd = window.innerHeight * 0.8; // fully solid before first screen ends
			
			if (scrollTop <= fadeStart) {
				overlay.style.opacity = "0";
			} else if (scrollTop >= fadeEnd) {
				overlay.style.opacity = "1";
			} else {
				const progress = (scrollTop - fadeStart) / (fadeEnd - fadeStart);
				overlay.style.opacity = progress.toString();
			}
		};

		window.addEventListener("scroll", handleScroll, { passive: true });
		handleScroll(); // Initial run
	});
</script>

<style>
	html {
		scroll-behavior: smooth;
		background: black;
	}
</style>
